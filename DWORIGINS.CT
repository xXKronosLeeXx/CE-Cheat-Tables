newmem:
  mov rax,#4261281792
 { 通过搜索，内存得到如下两组对应关系
   显示EXP   内存实际
   1853     1120534528
   1849     1121058816
   通过AI分析
   1120534528 + 131072 × 1853 = 1363410944
   1121058816 + 131072 × 1849 = 1363410944
   结论：这个计算的输出，本质是一个 float 的原始 32 位比特，被当作无符号整数读取出来。
   结论2: 满级174500的EXP，转换后，就是#4261150720  174499对应的是 #4261281792
    //**}

  cvtsi2ss xmm0,rax
  jmp return

