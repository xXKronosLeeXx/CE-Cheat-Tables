aobscanmodule(INJECT,Kena-Win64-Shipping.exe,F3 0F 5C C2 F3 0F 11 47 08) // should be unique
alloc(newmem,$1000,INJECT)
alloc(damage,$2,INJECT)

label(code)
label(return)
label(self)

damage:
  dq (float)100

self:  //判断整合妖精移动
  movss xmm0,[rdi+04]
  movss [rdi+08],xmm0
  jmp return

newmem:
  cmp [rdi+c],0  //整合妖精移动判断，oc=0就是敌人，可能：54=0是敌人,24=0敌人
  jne self
  cmp [rdi+2c],0   //2c自己2，敌人0；60自己不等于0，敌人0
  je code
  movss xmm0,[rdi+04]
  movss [rdi+08],xmm0
  jmp return

code:
  movss xmm2,[damage]
  subss xmm0,xmm2
  movss [rdi+08],xmm0
  jmp return

INJECT:
  jmp newmem
  nop 4
return:
registersymbol(INJECT)
registersymbol(damage)

