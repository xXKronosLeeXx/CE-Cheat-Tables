      <AssemblerScript>{ Game   : re9.exe
  Version: 
  Date   : 2026-03-07
  Author : krono

  This script does blah blah blah
}

[ENABLE]

aobscanmodule(INJECT,re9.exe,48 89 47 10 40 B7 01) // should be unique
alloc(newmem,$1000,INJECT)

label(code)
label(return)

newmem:
  mov [rdi+10],#3899999
  mov dil,01
  jmp return

code:
  mov [rdi+10],rax
  mov dil,01
  jmp return

INJECT:
  jmp newmem
  nop 2
return:
registersymbol(INJECT)

[DISABLE]

INJECT:
  db 48 89 47 10 40 B7 01

unregistersymbol(INJECT)
dealloc(newmem)

